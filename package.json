{
  "name": "pa-crawler-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "typecheck": "vue-tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "node --import tsx --test server/**/*.test.ts",
    "build": "npm run typecheck && vite build && tsc -p server/tsconfig.json",
    "start": "node dist-server/index.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "@lucide/vue": "^1.28.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vue-tsc": "^2.2.0"
  }
}
